{
  "crons": [
    {
      "path": "/api/crash-alert",
      "schedule": "*/3 * * * *"
    }
  ],
  "redirects": [
    { "source": "/(.*)", "destination": "https://www.crashhelptx.com/$1", "permanent": true, "has": [{ "type": "host", "value": "crashhelptx.com" }] }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/logo.svg", "destination": "/logo.svg" },
    { "source": "/og-image.png", "destination": "/og-image.png" },
    { "source": "/og-image.svg", "destination": "/og-image.svg" },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon.png" },
    { "source": "/partners", "destination": "/partners.html" },
    { "source": "/partners.html", "destination": "/partners.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy.html", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms.html", "destination": "/terms.html" },
    { "source": "/thank-you", "destination": "/thank-you.html" },
    { "source": "/thank-you.html", "destination": "/thank-you.html" },
    { "source": "/houston", "destination": "/houston.html" },
    { "source": "/houston.html", "destination": "/houston.html" },
    { "source": "/dallas", "destination": "/dallas.html" },
    { "source": "/dallas.html", "destination": "/dallas.html" },
    { "source": "/san-antonio", "destination": "/san-antonio.html" },
    { "source": "/san-antonio.html", "destination": "/san-antonio.html" },
    { "source": "/austin", "destination": "/austin.html" },
    { "source": "/austin.html", "destination": "/austin.html" },
    { "source": "/es", "destination": "/es.html" },
    { "source": "/es.html", "destination": "/es.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

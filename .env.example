# CrashHelp TX response engine — copy into Vercel → Project → Settings → Environment Variables.
# Never commit a real .env (it is already in .gitignore).

# ---- Site ----
PUBLIC_BASE_URL=https://www.crashhelptx.com      # must match the URL Twilio calls, or signatures fail
LANDING_PAGE_URL=https://www.crashhelptx.com/start

# ---- Database (Postgres: Neon via Vercel Marketplace, Supabase, etc.) ----
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=                               # required: used to verify Twilio webhooks
TWILIO_PHONE_NUMBER=+13468601929                 # the CrashHelp number (E.164)
# Optional: send with an API key instead of the auth token (auth token is still needed for webhooks)
# TWILIO_API_KEY=SKxxxxxxxx
# TWILIO_API_SECRET=

# Test mode: ONLY the numbers below get texts/calls. Leave true until you approve live contact.
TWILIO_TEST_MODE=true
ALLOWED_TEST_NUMBERS=+1832XXXXXXX,+1713XXXXXXX   # your phone, backup's phone, a test phone

# ---- Who gets alerted (can also be changed in Dashboard → Settings) ----
OWNER_ALERT_PHONE=+1832XXXXXXX
BACKUP_ALERT_PHONE=
OWNER_ALERT_EMAIL=crashhelptx@gmail.com
BACKUP_ALERT_EMAIL=

# ---- Email (Gmail SMTP with an app password) ----
GMAIL_USER=crashhelptx@gmail.com
GMAIL_APP_PASSWORD=

# ---- Dashboard login ----
SESSION_SECRET=                                  # 32+ random characters: openssl rand -hex 32
# Either a user list...
ADMIN_USERS=[{"name":"Josiah","role":"owner","password":"change-me"},{"name":"Staff","role":"staff","password":"change-me-too"}]
# ...or just:
# ADMIN_PASSWORD=
# STAFF_PASSWORD=

# ---- Escalation timer ----
CRON_SECRET=                                     # random string; the 1-minute pinger sends it

# ---- CRM ----
CRM_MODE=none                                    # none | ghl | webhook
# GoHighLevel (Private Integration token with contacts.write + opportunities.write scopes)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_IDS={"NEW":"","CONTACT ATTEMPTED":"","CONTACTED":"","QUALIFYING":"","QUALIFIED":"","APPOINTMENT SET":"","REFERRED":"","NO RESPONSE":"","CLOSED":""}
# Generic webhook (Zapier, Make, GHL inbound webhook trigger, etc.)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=                              # optional: signs the body as X-CrashHelp-Signature (HMAC-SHA256 hex)
